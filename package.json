{
  "name": "conduit-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "UI + API test framework for the RealWorld Conduit app: Playwright, TypeScript, layered fixtures, deterministic stubs, CI with published reports",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=ui",
    "test:headed": "playwright test --project=ui --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
